{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:clean": "powershell -Command \"if (Test-Path '.next/dev/cache/turbopack') { Remove-Item -Recurse -Force '.next/dev/cache/turbopack'; Write-Output 'cleared turbopack cache' }\" && next dev -H 0.0.0.0",
    "fixfs": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts\\fix-slow-filesystem.ps1\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "prepare": "husky",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "screenshots": "cypress run --spec \"cypress/e2e/screenshots.spec.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.561.0",
    "next": "^16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-to-print": "^3.2.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "dompurify": "^3.4.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "^15.14.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
