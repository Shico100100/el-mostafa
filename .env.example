# ========================================
# ELMostafa — Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ========================================
# Docker Compose Variables (root .env)
# ========================================
POSTGRES_PASSWORD=your-secure-postgres-password

# ----- Backend (backend/.env) -----
APP_PORT=3001
APP_NAME="ELMostafa API"
API_PREFIX=api

# Comma-separated list of allowed frontend origins (for WebSocket CORS)
# Add your network IP for LAN access, e.g.: http://localhost:3000,http://192.168.1.5:3000
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=elmostafa_db

# File storage driver: local | s3 | s3-presigned (required — backend fails to boot without it)
FILE_DRIVER=local

# Mail (required by backend boot validation)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_DEFAULT_EMAIL=noreply@elmostafa.com
MAIL_DEFAULT_NAME=ELMostafa
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=change-me-too
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_FORGOT_SECRET=change-me-forgot-secret
AUTH_FORGOT_TOKEN_EXPIRES_IN=1h
AUTH_CONFIRM_EMAIL_SECRET=change-me-confirm-secret
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# Redis (required for BullMQ job queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# ----- Frontend (frontend/.env.local) -----
NEXT_PUBLIC_API_URL=http://localhost:3001
